# LLM Configuration
LLM_PROVIDER=ollama
LLM_BASE_URL=http://your-llm-server-ip:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:26b

# Embedding Configuration
EMBEDDING_BASE_URL=http://your-embedding-server-ip:8003/v1
EMBEDDING_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

# Jina Reranker via vLLM Endpoint
RERANKER_BASE_URL=http://your-llm-server-ip/v1
RERANKER_MODEL=jina-reranker
RERANKER_MAX_QUERY_CHARS=200
RERANKER_MAX_DOCUMENT_CHARS=800

# Elasticsearch Vector Database Configuration
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=feedbackloop-documents
# ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=nfu123@@@

# RAG Retrieval Configuration
RAG_CHUNK_TOKEN_NUM=512
RAG_RETRIEVAL_TOP_K=20
RAG_RRF_CANDIDATE_TOP_K=30
RAG_RERANK_TOP_K=8
RAG_FINAL_CONTEXT_TOP_K=8
RAG_FIELD_SUMMARY_CANDIDATE_K=8
RAG_FIELD_DETAIL_CANDIDATE_K=20
RAG_GENERAL_CANDIDATE_K=12

# SQL Server Notebook Storage
DB_SERVER=your-sql-server
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=your-password

# OpenAI
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini